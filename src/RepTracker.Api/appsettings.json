{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "MaxAccounts": 50,
    "SessionDays": 60,
    "TrustProxyHeaders": false,
    "Limits": {
      "Workouts": 2000,
      "ExercisesPerWorkout": 40,
      "SetsPerExercise": 40,
      "CustomExercises": 300,
      "Routines": 60,
      "ExercisesPerRoutine": 40
    }
  }
}
